{
  "name": "dead-signal-works-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && bun run index:docs",
    "index:docs": "pagefind --site dist --glob 'meridian/docs/**/*.html' --force-language en",
    "check:site": "bun run build && bun scripts/check-site.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/hubot-sans": "^5.2.8",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "astro": "^7.1.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
