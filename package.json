{
  "name": "dead-signal-works-site",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && bun run typecheck",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "bun run check && astro build && bun run index:docs",
    "index:docs": "pagefind --site dist --glob '**/docs/**/*.html' --force-language en",
    "sync:alchemist-docs": "bun scripts/sync-alchemist-docs.ts",
    "audit:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "check:site": "bun run build && bun scripts/check-site.ts",
    "check:security": "bun audit --audit-level=high --ignore=GHSA-mh99-v99m-4gvg",
    "deploy": "bun run build && wrangler deploy",
    "preview": "astro preview",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:built": "playwright test",
    "verify": "bun run check:site && bun run check:security && bun run test:e2e:built"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "astro": "^7.1.3",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "sharp": "0.35.3",
    "tmp": "0.2.7"
  }
}
