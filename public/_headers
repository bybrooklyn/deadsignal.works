# Pagefind requires the narrow wasm-unsafe-eval capability for its local WASM index.
# Cloudflare Web Analytics is the only third-party script origin permitted.
/
  Link: </alchemist/docs/openapi.yaml>; rel="service-desc"; type="application/vnd.oai.openapi"
  Link: </alchemist/docs/>; rel="service-doc"; title="Alchemist API documentation"
  Link: </meridian/docs/>; rel="service-doc"; title="Meridian engine documentation"

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:
  Content-Signal: ai-train=no, search=yes, ai-input=yes
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), display-capture=(), geolocation=(), microphone=(), payment=(), publickey-credentials-get=(), usb=(), clipboard-write=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate
