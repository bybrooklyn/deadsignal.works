<script is:inline>
  (() => {
    const initializationKey = '__deadSignalSubsystemTransitionsInitialized';
    if (Reflect.get(globalThis, initializationKey)) return;
    Reflect.set(globalThis, initializationKey, true);

    const subsystemSlugs = new Set(['penumbra', 'cairn', 'wavefront', 'alluvium']);
    const subsystemPartNames = {
      role: 'subsystem-role',
      title: 'subsystem-title',
      pronunciation: 'subsystem-pronunciation',
      summary: 'subsystem-summary',
    };
    let activeSubsystemTransition = null;
    let transitionSequence = 0;

    const clearSubsystemNames = (root) => {
      root.querySelectorAll('[data-transition-active]').forEach((element) => {
        element.style.removeProperty('view-transition-name');
        element.removeAttribute('data-transition-active');
        element.removeAttribute('data-transition-source');
      });
    };

    const nameSubsystemElements = (container) => {
      container.dataset.transitionActive = 'true';
      container.dataset.transitionSource = 'true';

      const frame = container.querySelector('[data-subsystem-frame]');
      if (frame) {
        frame.dataset.transitionActive = 'true';
        frame.style.setProperty('view-transition-name', 'subsystem-frame');
      }

      Object.entries(subsystemPartNames).forEach(([part, transitionName]) => {
        const element = container.querySelector(`[data-subsystem-part="${part}"]`);
        if (!element) return;
        element.dataset.transitionActive = 'true';
        element.style.setProperty('view-transition-name', transitionName);
      });
    };

    const clearRootTransitionState = (root) => {
      delete root.dataset.subsystemTransition;
      delete root.dataset.subsystemDirection;
    };

    document.addEventListener('astro:before-preparation', (event) => {
      transitionSequence += 1;
      clearSubsystemNames(document);
      activeSubsystemTransition = null;
      clearRootTransitionState(document.documentElement);

      const source = event.sourceElement;
      const card = source instanceof Element
        ? source.closest('[data-subsystem-transition]')
        : null;
      const backLink = source instanceof Element
        ? source.closest('[data-subsystem-back]')
        : null;
      const cardSlug = card?.dataset.subsystemTransition;
      const backSlug = backLink?.dataset.subsystemBack;

      if (card && cardSlug && subsystemSlugs.has(cardSlug)) {
        activeSubsystemTransition = { slug: cardSlug, direction: 'forward', sequence: transitionSequence };
        nameSubsystemElements(card);
      } else if (backLink && backSlug && subsystemSlugs.has(backSlug)) {
        const hero = document.querySelector('[data-subsystem-hero]');
        if (hero) {
          activeSubsystemTransition = { slug: backSlug, direction: 'back', sequence: transitionSequence };
          nameSubsystemElements(hero);
        }
      } else if (
        event.navigationType === 'traverse'
        && event.direction === 'back'
        && event.to.pathname === '/meridian/'
      ) {
        const hero = document.querySelector('[data-subsystem-hero]');
        const heroSlug = hero?.dataset.subsystemHero;
        if (hero && heroSlug && subsystemSlugs.has(heroSlug)) {
          activeSubsystemTransition = { slug: heroSlug, direction: 'back', sequence: transitionSequence };
          nameSubsystemElements(hero);
        }
      }

      if (!activeSubsystemTransition) return;
      document.documentElement.dataset.subsystemTransition = activeSubsystemTransition.slug;
      document.documentElement.dataset.subsystemDirection = activeSubsystemTransition.direction;
    });

    document.addEventListener('astro:before-swap', (event) => {
      if (!activeSubsystemTransition) return;

      const transition = activeSubsystemTransition;
      const selector = transition.direction === 'forward'
        ? `[data-subsystem-hero="${transition.slug}"]`
        : `[data-subsystem-transition="${transition.slug}"]`;
      const target = event.newDocument.querySelector(selector);

      event.newDocument.documentElement.dataset.subsystemTransition = transition.slug;
      event.newDocument.documentElement.dataset.subsystemDirection = transition.direction;
      if (target) nameSubsystemElements(target);

      const finish = () => {
        if (activeSubsystemTransition?.sequence !== transition.sequence) return;
        clearSubsystemNames(document);
        clearRootTransitionState(document.documentElement);
        activeSubsystemTransition = null;
      };
      if (event.viewTransition?.finished) {
        void event.viewTransition.finished.then(finish, finish);
      } else {
        finish();
      }
    });

    document.addEventListener('astro:page-load', () => {
      if (activeSubsystemTransition) return;
      clearSubsystemNames(document);
      clearRootTransitionState(document.documentElement);
    });
  })();
</script>
