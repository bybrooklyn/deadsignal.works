---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visibleHeadings.length > 0 && (
  <aside class="docs-toc" aria-label="Page contents" data-pagefind-ignore>
    <p>On this page</p>
    <nav aria-label="On this page">
      {visibleHeadings.map((heading) => (
        <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </nav>
  </aside>
)}
