---
import { docsGroups } from '../data/docs';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<aside class="docs-sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
  <nav aria-label="Documentation sections">
    {docsGroups.map((group) => (
      <section>
        <p>{group.label}</p>
        {group.items.map((item) => (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </section>
    ))}
  </nav>
</aside>

<script is:inline>
  (() => {
    const initializationKey = '__deadSignalDocsSidebarInitialized';
    if (Reflect.get(globalThis, initializationKey)) return;
    Reflect.set(globalThis, initializationKey, true);

    let savedScrollTop = 0;
    let hasSavedPosition = false;

    document.addEventListener('astro:before-swap', () => {
      const sidebar = document.querySelector('.docs-sidebar');
      if (!(sidebar instanceof HTMLElement)) return;
      savedScrollTop = sidebar.scrollTop;
      hasSavedPosition = true;
    });

    document.addEventListener('astro:page-load', () => {
      if (!hasSavedPosition) return;
      const sidebar = document.querySelector('.docs-sidebar');
      if (sidebar instanceof HTMLElement) sidebar.scrollTop = savedScrollTop;
    });
  })();
</script>
