---
interface Props {
  value: string;
  label?: string;
}

const { value, label = 'Copy text' } = Astro.props;
---

<button class="copy-button" type="button" data-copy-value={value}>{label}</button>

<script is:inline>
  (() => {
    const button = document.currentScript?.previousElementSibling;
    if (!(button instanceof HTMLButtonElement) || !button.matches('[data-copy-value]')) return;

    button.addEventListener('click', async () => {
      const value = button.dataset.copyValue;
      if (!value) return;

      const original = button.textContent ?? 'Copy text';
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      window.setTimeout(() => { button.textContent = original; }, 1600);
    });
  })();
</script>
