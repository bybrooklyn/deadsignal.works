---
import { site } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const classes = ['action', className].filter(Boolean);
---

{site.steamWishlistUrl
  ? <a class:list={classes} href={site.steamWishlistUrl} target="_blank" rel="noreferrer">Wishlist on Steam <span aria-hidden="true">↗</span></a>
  : <a class:list={classes} href="/updates/">Follow development <span aria-hidden="true">↗</span></a>}
