---
import { site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const meridianLinks = [
  { label: 'Engine overview', href: '/meridian/' },
  { label: 'Documentation', href: '/meridian/docs/' },
  { label: 'Penumbra', detail: 'Rendering', href: '/meridian/penumbra/' },
  { label: 'Cairn', detail: 'Physics', href: '/meridian/cairn/' },
  { label: 'Wavefront', detail: 'Audio', href: '/meridian/wavefront/' },
  { label: 'Alluvium', detail: 'Procedural worlds', href: '/meridian/alluvium/' },
] as const;

const alchemistLinks = [
  { label: 'Project overview', href: '/alchemist/' },
  { label: 'Documentation', href: '/alchemist/docs/' },
  { label: 'GitHub', href: 'https://github.com/bybrooklyn/alchemist' },
  { label: 'Releases', href: 'https://github.com/bybrooklyn/alchemist/releases' },
] as const;

const connectLinks = [
  { label: 'Join Discord', href: site.discord, external: true },
  { label: 'Contact', href: '/contact/', external: false },
  { label: 'Press information', href: '/press/', external: false },
] as const;

const directLinks = [
  { label: 'Project Meridian', href: '/project-meridian/' },
  { label: 'Meridian', href: '/meridian/' },
  { label: 'Alchemist', href: '/alchemist/' },
  { label: 'Studio', href: '/studio/' },
  { label: 'Devlog', href: '/updates/' },
  { label: 'Contact', href: '/contact/' },
] as const;

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<div class="site-navigation" data-site-navigation>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {directLinks.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <details class="mobile-nav" name="mobile-navigation" data-nav-disclosure>
    <summary class="mobile-nav-trigger">Menu <span aria-hidden="true">+</span></summary>
    <nav class="mobile-nav-panel" aria-label="Mobile navigation">
      <a href="/project-meridian/" aria-current={isCurrent('/project-meridian/') ? 'page' : undefined}>Project Meridian</a>
      <section>
        <a href="/meridian/" aria-current={currentPath === '/meridian/' ? 'page' : undefined}>Meridian</a>
        <div>
          {meridianLinks.slice(1).map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </section>
      <section>
        <a href="/alchemist/" aria-current={currentPath === '/alchemist/' ? 'page' : undefined}>Alchemist</a>
        <div>
          {alchemistLinks.slice(1).map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </section>
      <a href="/studio/" aria-current={isCurrent('/studio/') ? 'page' : undefined}>Studio</a>
      <a href="/updates/" aria-current={isCurrent('/updates/') ? 'page' : undefined}>Devlog</a>
      <section>
        <span>Connect</span>
        <div>
          {connectLinks.map((item) => (
            <a
              href={item.href}
              aria-current={!item.external && currentPath === item.href ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noreferrer' : undefined}
            >{item.label}</a>
          ))}
        </div>
      </section>
    </nav>
  </details>
</div>

<script is:inline>(()=>{let e=globalThis;if(e.__dsNav)return;e.__dsNav=!0;let t=`details[data-nav-disclosure]`,n=()=>[...document.querySelectorAll(t)].filter(e=>e instanceof HTMLDetailsElement),r=(e,t=!1)=>{e.open&&(e.removeAttribute(`open`),t&&e.querySelector(`summary`)?.focus())},i=(e=!1)=>n().forEach(t=>r(t,e));document.addEventListener(`toggle`,e=>{let i=e.target;!(i instanceof HTMLDetailsElement)||!i.matches(t)||!i.open||n().forEach(e=>{e!==i&&r(e)})},!0),document.addEventListener(`pointerdown`,e=>{let t=e.target;t instanceof Node&&(n().filter(e=>e.open).some(e=>e.contains(t))||i())}),document.addEventListener(`click`,e=>{let n=e.target;!(n instanceof Element)||!n.closest(`${t} a`)||i()}),document.addEventListener(`keydown`,e=>{if(e.key!==`Escape`)return;let t=n().find(e=>e.open);t&&(e.preventDefault(),r(t,!0))})})();</script>
