---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyText from '../components/CopyText.astro';
import { site } from '../data/site';

const studioFacts = [
  ['Company', site.legalName],
  ['Type', 'Independent solo game and software studio'],
  ['Focus', 'Games, custom engine technology, and open-source software'],
  ['Current game', 'Project Meridian — working title'],
  ['Engine', 'Meridian — source private during early development; relicensed to MPL-2.0 for open-source release'],
  ['Open-source software', 'Alchemist — self-hosted media transcoding automation under AGPL-3.0-or-later'],
];
---

<BaseLayout title="Press information" description="Facts and contact information for Dead Signal Works, Project Meridian, Meridian, and Alchemist." currentPath="/press/">
  <section class="page-hero press-hero shell">
    <p class="kicker"><span>Press information</span></p>
    <h1>The useful facts, minus the boilerplate.</h1>
    <p class="page-lede">Copy-ready information about Dead Signal Works, Project Meridian, Meridian, and Alchemist. There is no logo pack or screenshot folder hiding behind an impressive button yet.</p>
    <a class="action action-primary" href={`mailto:${site.pressEmail}`}>Email press <span aria-hidden="true">↗</span></a>
  </section>

  <section class="content-section surface-section">
    <div class="shell">
      <div class="section-heading"><p class="section-number">01 / Studio facts</p><h2>Dead Signal Works</h2></div>
      <dl class="project-fact-sheet">
        {studioFacts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
      <div class="press-copy-row"><CopyText value="Dead Signal Works is an independent solo studio building Project Meridian, the Meridian engine, and the open-source Alchemist media transcoding application." label="Copy studio description" /></div>
    </div>
  </section>

  <section class="content-section shell press-sections">
    <article>
      <p class="section-number">02 / Project Meridian</p>
      <h2>Game summary</h2>
      <p>Project Meridian is the working title for a single-player, first-person liminal horror game built around exploration across a large continuous world. It is a solo-led commercial game in early development, targeting Windows, Linux, Steam Deck, and macOS. Steam is the primary intended storefront. No release date has been announced.</p>
      <CopyText value="Project Meridian is the working title for a single-player, first-person liminal horror game built around exploration across a large continuous world. It is a solo-led commercial game in early development. No release date has been announced." label="Copy game summary" />
      <a class="text-action" href="/project-meridian/">Project page <span aria-hidden="true">↗</span></a>
    </article>
    <article>
      <p class="section-number">03 / Meridian</p>
      <h2>Engine summary</h2>
      <p>Meridian is an experimental general-purpose game and interactive-application engine written in Rust and built around one integrated creator application. Its source is private during early development, and it has been relicensed to MPL-2.0 for its planned open-source release. Current foundations and future direction are labeled separately.</p>
      <CopyText value="Meridian is an experimental general-purpose game and interactive-application engine written in Rust and built around one integrated creator application. Its source is private during early development, and it has been relicensed to MPL-2.0 for its planned open-source release." label="Copy engine summary" />
      <a class="text-action" href="/meridian/">Engine page <span aria-hidden="true">↗</span></a>
    </article>
    <article>
      <p class="section-number">04 / Alchemist</p>
      <h2>Software summary</h2>
      <p>Alchemist is a self-hosted media transcoding application written in Rust with a web interface. It analyzes a media library, encodes only when the result is worthwhile, and explains each skip decision. It supports Linux, Windows, macOS, and Docker under AGPL-3.0-or-later, with no paid tier or private feature tree.</p>
      <CopyText value="Alchemist is a self-hosted media transcoding application that analyzes a media library, encodes only when the result is worthwhile, and explains each skip decision. It is available under AGPL-3.0-or-later with no paid tier or private feature tree." label="Copy Alchemist summary" />
      <a class="text-action" href="/alchemist/">Software page <span aria-hidden="true">↗</span></a>
    </article>
    <article>
      <p class="section-number">05 / Assets</p>
      <h2>Not available yet.</h2>
      <p>No public logo pack, screenshots, trailer, key art, or gameplay footage has been approved. The site artwork is site artwork—not an especially abstract gameplay reveal.</p>
    </article>
  </section>
</BaseLayout>
