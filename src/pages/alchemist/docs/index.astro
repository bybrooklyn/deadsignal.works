---
import { getEntry, render } from 'astro:content';
import { alchemistDocumentation } from '../../../data/alchemistDocs';
import DocsLayout from '../../../layouts/DocsLayout.astro';

const entry = await getEntry('alchemistDocs', 'overview');
if (!entry) throw new Error('The generated Alchemist overview is missing. Run bun run sync:alchemist-docs.');
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={alchemistDocumentation.docsRoot}
  group="overview"
  headings={headings}
  sourceRevision={entry.data.sourceRevision}
  sourcePath={entry.data.sourcePath}
  product={alchemistDocumentation}
  home
>
  <header class="docs-home-hero">
    <p class="kicker"><span>Alchemist documentation</span> / A Dead Signal Works project</p>
    <h1 data-pagefind-meta="title">Alchemist.</h1>
    <p>{entry.data.description}</p>
    <div class="inline-actions">
      <a class="action action-primary" href="/alchemist/docs/installation/">Install Alchemist <span aria-hidden="true">↗</span></a>
      <a class="action" href="/alchemist/docs/docker/">Run with Docker <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <div class="docs-prose">
    <Content />
  </div>
</DocsLayout>
