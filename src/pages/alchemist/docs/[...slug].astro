---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { alchemistDocsItemById, alchemistDocumentation } from '../../../data/alchemistDocs';
import DocsLayout from '../../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('alchemistDocs');
  return entries
    .filter((entry) => entry.id !== 'overview')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\/index$/u, '') },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<'alchemistDocs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const navigationItem = alchemistDocsItemById[entry.id];
if (!navigationItem) throw new Error(`Alchemist documentation entry ${entry.id} is missing from the navigation registry.`);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={navigationItem.href}
  group={navigationItem.group}
  headings={headings}
  sourceRevision={entry.data.sourceRevision}
  sourcePath={entry.data.sourcePath}
  product={alchemistDocumentation}
  contentHasH1={headings.some((heading) => heading.depth === 1)}
>
  <Content />
</DocsLayout>
