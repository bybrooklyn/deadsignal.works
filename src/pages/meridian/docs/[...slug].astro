---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { docsItemById } from '../../../data/docs';
import DocsLayout from '../../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentPath = `/meridian/docs/${entry.id}/`;
const navigationItem = docsItemById[entry.id];
if (!navigationItem) throw new Error(`Documentation entry ${entry.id} is missing from the navigation registry.`);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={currentPath}
  group={navigationItem.group}
  headings={headings}
  updated={entry.data.updated}
  sourceRevision={entry.data.sourceRevision}
  sources={entry.data.sources}
>
  <Content />
</DocsLayout>
