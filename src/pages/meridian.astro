---
import BaseLayout from '../layouts/BaseLayout.astro';
import InPageNav from '../components/InPageNav.astro';
import MotionSubsystemGrid from '../components/MotionSubsystemGrid';
import { subsystems } from '../data/subsystems';
import { site } from '../data/site';

const codeSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Meridian',
  description: `An experimental general-purpose game and interactive-application engine written in Rust. An open-source release is planned under ${site.engineReleaseLicense}.`,
  programmingLanguage: 'Rust',
  url: `${site.url}/meridian/`,
};
---

<BaseLayout title="Meridian" description="The Rust engine and integrated creator application behind Project Meridian, relicensed to MPL-2.0 for an open-source release." currentPath="/meridian/" structuredData={codeSchema} enableSubsystemTransitions>
  <section class="meridian-hero" id="overview">
    <div class="shell meridian-hero-grid">
      <div>
        <p class="kicker"><span>Open-source release planned</span> / Rust</p>
        <h1>Meridian</h1>
        <p class="page-lede">I started Meridian because the game I wanted to make needed an engine I couldn’t buy.</p>
        <p class="meridian-license-note">Meridian has been relicensed to MPL-2.0. Source is private during early development.</p>
        <div class="inline-actions">
          <a class="action action-primary" href="/meridian/docs/">Read the docs <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="meridian-status-panel" aria-label="Meridian development status">
        <p class="section-number">Meridian / early development</p>
        <h2>One engine. One creator application.</h2>
        <dl>
          <div><dt>Source</dt><dd>Private while early development continues</dd></div>
          <div><dt>License</dt><dd>MPL-2.0 — relicensed</dd></div>
          <div><dt>Guide</dt><dd>Public documentation available now</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <InPageNav items={[
    { label: 'Overview', href: '#overview' },
    { label: 'Purpose and use', href: '#purpose' },
    { label: 'Named systems', href: '#subsystems' },
    { label: 'Current state and docs', href: '#direction' },
  ]} />

  <div class="meridian-chapter meridian-purpose-chapter">
    <section class="content-section shell prose-split" id="purpose">
      <div><p class="section-number">01 / Why it exists</p><h2>The game came first. The engine followed.</h2></div>
      <div class="copy-stack">
        <p class="large-copy">Meridian is an experimental general-purpose engine for games and interactive applications, written in Rust and built around one integrated creator application.</p>
        <p>Project Meridian is the first proving game. Reusable systems are being prepared for the eventual public engine repository; the game’s creative work stays in its private repository. That keeps the engine useful without turning the game inside out.</p>
      </div>
    </section>

    <section class="content-section surface-section" id="use">
      <div class="shell">
        <div class="section-heading meridian-section-heading"><p class="section-number">02 / Use Meridian</p><h2>Built for people who want to work close to the engine.</h2><p>Meridian is under active development. Its source remains private while the foundations and release boundary are prepared.</p></div>
        <div class="meridian-use-grid">
          <article><span>01</span><h3>Open when it is ready.</h3><p>Meridian has been relicensed to MPL-2.0; the source will open after the early development boundary is ready.</p></article>
          <article><span>02</span><h3>Keep the tools together.</h3><p>The engine and its creator application are one product instead of separate layers with separate rules.</p></article>
          <article><span>03</span><h3>Follow what is real.</h3><p>The repository separates working foundations, evidence, and future direction so experiments do not masquerade as finished features.</p></article>
        </div>
      </div>
    </section>
  </div>

  <section class="content-section shell" id="subsystems">
    <div class="section-heading meridian-section-heading"><p class="section-number">03 / Named systems</p><h2>Four ambitious parts of the engine.</h2><p>The marketing pages explain what they are trying to become. Their technical guides carry the exact implementation details.</p></div>
    <MotionSubsystemGrid items={subsystems} client:visible />
  </section>

  <div class="meridian-chapter meridian-current-chapter">
    <section class="content-section direction-board" id="direction">
      <div class="shell prose-split">
        <div><p class="section-number">04 / Direction</p><h2>The broader engine is still under construction.</h2></div>
        <div class="copy-stack">
          <p class="large-copy">Meridian is under active construction. Working foundations and future systems live side by side in private source and are described here without pretending the complete product already exists.</p>
        </div>
      </div>
    </section>

    <section class="content-section shell read-more-panel" id="documentation">
      <div><p class="section-number">05 / Documentation</p><h2>For developers and curious souls.</h2><p>The approachable guide lives here. Normative specifications and evidence remain in the private engine repository until the source release.</p></div>
      <div class="stacked-actions">
        <a class="action action-primary" href="/meridian/docs/">Start with the guide <span aria-hidden="true">↗</span></a>
        <p class="availability-note">Source access remains private for now.</p>
      </div>
    </section>
  </div>
</BaseLayout>
