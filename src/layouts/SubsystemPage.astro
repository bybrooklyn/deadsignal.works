---
import BaseLayout from './BaseLayout.astro';
import InPageNav from '../components/InPageNav.astro';
import type { Subsystem } from '../data/subsystems';
import { site } from '../data/site';

interface Props {
  subsystem: Subsystem;
}

const { subsystem } = Astro.props;
const docsUrl = `/meridian/docs/systems/${subsystem.slug}/`;
---

<BaseLayout title={`${subsystem.name} — Meridian`} description={subsystem.summary} currentPath={`/meridian/${subsystem.slug}/`} enableSubsystemTransitions>
  <section class:list={['subsystem-hero', `tone-${subsystem.tone}`]} data-subsystem-hero={subsystem.slug}>
    <span class="subsystem-transition-frame" data-subsystem-frame aria-hidden="true"></span>
    <div class="shell subsystem-hero-grid">
      <div>
        <p class="kicker"><span class="subsystem-kicker-brand">Meridian</span> / <span class="subsystem-kicker-role" data-subsystem-part="role">{subsystem.role}</span></p>
        <p class="status-label">{subsystem.maturity}</p>
        <div class="subsystem-title-line">
          <h1 data-subsystem-part="title">{subsystem.name}</h1>
          <span data-subsystem-part="pronunciation" aria-label={`pronounced ${subsystem.pronunciationLabel}`}>{subsystem.pronunciation}</span>
        </div>
        <p class="page-lede" data-subsystem-part="summary">{subsystem.summary}</p>
        <div class="inline-actions">
          <a class="action action-primary" href={docsUrl}>Read the technical guide <span aria-hidden="true">↗</span></a>
          <a class="action" href="/meridian/">Back to Meridian <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="subsystem-side subsystem-visual" aria-label={`${subsystem.name} visual diagram`}>
        <p>{subsystem.introduction}</p>
        <div class:list={['subsystem-diagram', `diagram-${subsystem.slug}`]} aria-hidden="true">
          {subsystem.slug === 'penumbra' && <><span>World</span><i></i><span>Graph</span><i></i><span>Frame</span></>}
          {subsystem.slug === 'cairn' && <><b></b><b></b><b></b><i></i></>}
          {subsystem.slug === 'wavefront' && <>{[1, 2, 3, 4, 5, 6, 7, 8, 9].map(() => <i></i>)}</>}
          {subsystem.slug === 'alluvium' && <><span>Recipe</span><i></i><span>Evaluate</span><i></i><span>Result</span></>}
        </div>
      </aside>
    </div>
  </section>

  <InPageNav items={[
    { label: 'Purpose', href: '#purpose' },
    { label: 'Ambition', href: '#ambition' },
    { label: 'Direction', href: '#direction' },
    { label: 'Read more', href: '#read-more' },
  ]} />

  <section class="content-section shell prose-split" id="purpose">
    <div><p class="section-number">01 / Purpose</p><h2>{subsystem.purposeTitle}</h2></div>
    <p class="large-copy">{subsystem.summary}</p>
  </section>

  <section class="content-section shell" id="ambition">
    <div class="section-heading"><p class="section-number">02 / Ambition</p><h2>{subsystem.ambitionTitle}</h2><p>The technical guide keeps current implementation and long-term direction separate.</p></div>
    <ol class="numbered-list">
      {subsystem.ambition.map((item, index) => <li><span>0{index + 1}</span><p>{item}</p></li>)}
    </ol>
  </section>

  <section class="content-section surface-section" id="direction">
    <div class="shell prose-split">
      <div><p class="section-number">03 / Direction</p><h2>{subsystem.directionTitle}</h2></div>
      <ol class="plain-list">
        {subsystem.direction.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section class="content-section shell read-more-panel" id="read-more">
    <div><p class="section-number">04 / Read more</p><h2>The detailed version lives in the docs.</h2></div>
    <div class="stacked-actions">
      <a class="action action-primary" href={docsUrl}>Read the subsystem guide <span aria-hidden="true">↗</span></a>
      {site.engineSourcePublic
        ? <a class="action" href={`${site.engineRepository}${subsystem.specPath}`} target="_blank" rel="noreferrer">Open the normative specification <span aria-hidden="true">↗</span></a>
        : <button class="action action-unavailable" type="button" disabled>Normative source <small>Private for now</small></button>}
      <a class="action" href="/meridian/">Back to Meridian <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
