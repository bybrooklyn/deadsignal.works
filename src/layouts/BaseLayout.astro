---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SubsystemTransitions from '../components/SubsystemTransitions.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  enableSubsystemTransitions?: boolean;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname,
  ogType = 'website',
  noindex = false,
  structuredData,
  enableSubsystemTransitions = false,
} = Astro.props;

const canonicalPath = currentPath === '/' ? '/' : `${currentPath.replace(/\/+$/u, '')}/`;
const canonical = new URL(canonicalPath, site.url).toString();
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: `${site.url}/`,
  description: site.description,
  sameAs: [
    ...(site.engineSourcePublic ? [site.engineRepository] : []),
    site.tiktok,
  ],
};
const jsonLd = structuredData ?? organization;
const serializedJsonLd = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
const socialImage = new URL('/social-card.png', site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090B0B" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} devlog`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dead Signal Works — Project Meridian and the Meridian engine" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Dead Signal Works — Project Meridian and the Meridian engine" />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={serializedJsonLd}></script>
    <ClientRouter fallback="swap" />
    {enableSubsystemTransitions && <SubsystemTransitions />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={canonicalPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
