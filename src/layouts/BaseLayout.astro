---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname,
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const canonical = new URL(currentPath, site.url).toString();
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: site.url,
  description: site.description,
  sameAs: [
    ...(site.engineSourcePublic ? [site.engineRepository] : []),
    site.tiktok,
  ],
};
const jsonLd = structuredData ?? organization;
const socialImage = new URL('/social-card.svg', site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090B0B" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Dead Signal Works — Project Meridian and the Meridian engine" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <ClientRouter fallback="swap" />
    <script>
      const subsystemSlugs = new Set(['penumbra', 'cairn', 'wavefront', 'alluvium']);
      const subsystemPartNames = {
        role: 'subsystem-role',
        title: 'subsystem-title',
        pronunciation: 'subsystem-pronunciation',
        summary: 'subsystem-summary',
      } as const;
      type SubsystemTransition = { slug: string; direction: 'forward' | 'back' };
      let activeSubsystemTransition: SubsystemTransition | null = null;

      const clearSubsystemNames = (root: ParentNode) => {
        root.querySelectorAll<HTMLElement>('[data-transition-active]').forEach((element) => {
          element.style.removeProperty('view-transition-name');
          element.removeAttribute('data-transition-active');
          element.removeAttribute('data-transition-source');
        });
      };

      const nameSubsystemElements = (container: HTMLElement) => {
        container.dataset.transitionActive = 'true';
        container.dataset.transitionSource = 'true';

        const frame = container.querySelector<HTMLElement>('[data-subsystem-frame]');
        if (frame) {
          frame.dataset.transitionActive = 'true';
          frame.style.setProperty('view-transition-name', 'subsystem-frame');
        }

        Object.entries(subsystemPartNames).forEach(([part, transitionName]) => {
          const element = container.querySelector<HTMLElement>(`[data-subsystem-part="${part}"]`);
          if (!element) return;
          element.dataset.transitionActive = 'true';
          element.style.setProperty('view-transition-name', transitionName);
        });
      };

      const clearRootTransitionState = (root: HTMLElement) => {
        delete root.dataset.subsystemTransition;
        delete root.dataset.subsystemDirection;
      };

      document.addEventListener('astro:before-preparation', (event) => {
        clearSubsystemNames(document);
        activeSubsystemTransition = null;
        clearRootTransitionState(document.documentElement);

        const source = event.sourceElement;
        const card = source instanceof Element
          ? source.closest<HTMLElement>('[data-subsystem-transition]')
          : null;
        const cardSlug = card?.dataset.subsystemTransition;

        if (card && cardSlug && subsystemSlugs.has(cardSlug)) {
          activeSubsystemTransition = { slug: cardSlug, direction: 'forward' };
          nameSubsystemElements(card);
        } else if (
          event.navigationType === 'traverse'
          && event.direction === 'back'
          && event.to.pathname.replace(/\/$/, '') === '/meridian'
        ) {
          const hero = document.querySelector<HTMLElement>('[data-subsystem-hero]');
          const heroSlug = hero?.dataset.subsystemHero;
          if (hero && heroSlug && subsystemSlugs.has(heroSlug)) {
            activeSubsystemTransition = { slug: heroSlug, direction: 'back' };
            nameSubsystemElements(hero);
          }
        }

        if (!activeSubsystemTransition) return;
        document.documentElement.dataset.subsystemTransition = activeSubsystemTransition.slug;
        document.documentElement.dataset.subsystemDirection = activeSubsystemTransition.direction;
      });

      document.addEventListener('astro:before-swap', (event) => {
        if (!activeSubsystemTransition) return;

        const transition = activeSubsystemTransition;
        const selector = transition.direction === 'forward'
          ? `[data-subsystem-hero="${transition.slug}"]`
          : `[data-subsystem-transition="${transition.slug}"]`;
        const target = event.newDocument.querySelector<HTMLElement>(selector);

        event.newDocument.documentElement.dataset.subsystemTransition = transition.slug;
        event.newDocument.documentElement.dataset.subsystemDirection = transition.direction;
        if (target) nameSubsystemElements(target);

        const finish = () => {
          if (activeSubsystemTransition !== transition) return;
          clearSubsystemNames(document);
          clearRootTransitionState(document.documentElement);
          activeSubsystemTransition = null;
        };
        void event.viewTransition.finished.then(finish, finish);
      });

      document.addEventListener('astro:page-load', () => {
        if (activeSubsystemTransition) return;
        clearSubsystemNames(document);
        clearRootTransitionState(document.documentElement);
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
