---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsSourceAvailability from '../components/DocsSourceAvailability.astro';
import DocsTableOfContents from '../components/DocsTableOfContents.astro';
import DocsToolbar from '../components/DocsToolbar.astro';
import { docsGroups, docsItems } from '../data/docs';
import { docsSnapshot, docsSnapshotShortRevision } from '../data/docsSnapshot';
import { site } from '../data/site';
import '../styles/docs.css';

interface SourceLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  currentPath: string;
  group?: 'learn' | 'build' | 'systems' | 'reference';
  headings?: MarkdownHeading[];
  updated?: Date;
  sourceRevision?: string;
  sources?: SourceLink[];
  home?: boolean;
}

const {
  title,
  description,
  currentPath,
  group,
  headings = [],
  updated,
  sourceRevision,
  sources = [],
  home = false,
} = Astro.props;

const currentIndex = docsItems.findIndex((item) => item.href === currentPath);
const previous = currentIndex > 0 ? docsItems[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < docsItems.length - 1 ? docsItems[currentIndex + 1] : undefined;
const groupLabel = docsGroups.find((entry) => entry.id === group)?.label;
const isCurrentStatus = currentPath === '/meridian/docs/learn/current-status/';
const snapshotDate = new Date(`${docsSnapshot.updated}T00:00:00.000Z`).toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Meridian docs`} description={description} currentPath={currentPath}>
  <DocsToolbar currentPath={currentPath} />
  {home ? (
    <article class="docs-home shell" data-pagefind-body>
      <DocsSourceAvailability detail="These guides describe the engine while that release is prepared." />
      <slot />
    </article>
  ) : (
    <div class="docs-frame shell">
      <DocsSidebar currentPath={currentPath} />
      <article class="docs-article" data-pagefind-body>
        <nav class="docs-breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol>
            <li><a href="/meridian/docs/">Docs</a></li>
            {groupLabel && <li><span aria-hidden="true">/</span><span aria-current="page">{groupLabel}</span></li>}
          </ol>
        </nav>
        <header class="docs-article-header">
          {groupLabel && <p data-pagefind-ignore>{groupLabel}</p>}
          <h1 data-pagefind-meta="title">{title}</h1>
          <p>{description}</p>
          {!isCurrentStatus && (updated || sourceRevision) && (
            <div class="docs-source-meta" data-pagefind-ignore>
              {updated && <span>Updated {updated.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</span>}
              {sourceRevision && <span>{site.engineSourcePublic ? 'Source revision' : 'Private source revision'} {sourceRevision.slice(0, 7)}</span>}
            </div>
          )}
        </header>
        {isCurrentStatus ? (
          <aside class="docs-status-provenance" role="note" data-pagefind-ignore data-docs-snapshot={docsSnapshot.revision}>
            <div>
              <strong>Current public snapshot</strong>
              <p>This page describes the private source boundary without presenting it as a live dashboard or exposing the repository before release.</p>
            </div>
            <dl>
              <div><dt>Snapshot</dt><dd><time datetime={`${docsSnapshot.updated}T00:00:00.000Z`}>{snapshotDate}</time></dd></div>
              <div><dt>Private source</dt><dd><code>{docsSnapshotShortRevision}</code></dd></div>
              <div><dt>Site build</dt><dd><time data-site-build datetime={__DEAD_SIGNAL_SITE_BUILD_TIMESTAMP__}>{__DEAD_SIGNAL_SITE_BUILD_TIMESTAMP__}</time></dd></div>
            </dl>
          </aside>
        ) : (
          <DocsSourceAvailability detail="The technical detail remains available here in the meantime." />
        )}
        <div class="docs-prose">
          <slot />
        </div>
        {site.engineSourcePublic && sources.length > 0 && (
          <section class="docs-sources" data-pagefind-ignore>
            <h2>Authoritative sources</h2>
            <p>This guide is explanatory. These repository sources carry authority.</p>
            <ul>{sources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul>
          </section>
        )}
        <nav class="docs-pagination" aria-label="Documentation pagination" data-pagefind-ignore>
          {previous ? <a href={previous.href}><span>Previous</span><strong>{previous.label}</strong></a> : <span />}
          {next && <a href={next.href}><span>Next</span><strong>{next.label}</strong></a>}
        </nav>
      </article>
      <DocsTableOfContents headings={headings} />
    </div>
  )}
</BaseLayout>
