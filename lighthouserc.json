{
  "ci": {
    "collect": {
      "startServerCommand": "bunx wrangler dev --local --port 4322",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/project-meridian/",
        "http://127.0.0.1:4322/meridian/docs/",
        "http://127.0.0.1:4322/alchemist/",
        "http://127.0.0.1:4322/alchemist/docs/hardware/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.92
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
